set -euxo pipefail

podman run \
  --detach \
  --env=ALSOFT_LOGLEVEL=3 \
  --name=openal-soft \
  --rm \
  --volume="$HOME/Code/openal-soft:$HOME/openal-soft:ro" \
  localhost/dev-environment
podman exec --user=root openal-soft apt-get update
podman exec --user=root openal-soft apt-get -y build-dep openal-soft
podman exec -i openal-soft tee ~/.config/alsoft.conf <<'EOF'
[general]
drivers = wave
channels = $AL_CHANNELS
[wave]
file = $HOME/output.wav
EOF
podman exec openal-soft bash -c \
  'mkdir build && cd build && cmake ../openal-soft'
