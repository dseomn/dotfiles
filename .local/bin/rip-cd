import argparse
import os
import pathlib
import subprocess
import sys


def _require_nonexistent(path: pathlib.Path):
    if path.exists(follow_symlinks=False):
        raise Exception(f"{str(path)!r} already exists.")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("-d", "--device", default="/dev/cdrom")
    parser.add_argument("--disc-number", type=int, default=1)
    args = parser.parse_args()
    path_prefix = f"d{args.disc_number:02d}"

    disc_info_path = pathlib.Path(f"{path_prefix}.cdrdao-disk-info.txt")
    with disc_info_path.open("x") as disc_info_file:
        subprocess.run(
            ("cdrdao", "disk-info", "--device", args.device),
            stdout=disc_info_file,
            stderr=disc_info_file,
            check=True,
        )
    with disc_info_path.open("r") as disc_info_file:
        sys.stdout.write(disc_info_file.read())

    whipper_disc_path = pathlib.Path(path_prefix)
    _require_nonexistent(whipper_disc_path)
    subprocess.run(
        (
            "whipper",
            "cd",
            f"--device={args.device}",
            "rip",
            f"--output-directory={whipper_disc_path}",
        ),
        check=True,
        env={
            **os.environ,
            # TODO: https://codeberg.org/sox_ng/sox_ng/issues/826 - Remove this.
            "SOX_OPTS": "--single-threaded",
        },
    )
    subprocess.run(
        (
            "metaflac",
            "--remove-tag=album",
            "--remove-tag=artist",
            "--remove-tag=title",
            f"--set-tag=discnumber={args.disc_number}",
            "--",
            *whipper_disc_path.glob("*.flac"),
        ),
        check=True,
    )
    for whipper_file_path in tuple(whipper_disc_path.iterdir()):
        # TODO(https://github.com/python/cpython/issues/56950): Fix this race
        # condition.
        new_path = pathlib.Path(f"{path_prefix}{whipper_file_path.name}")
        _require_nonexistent(new_path)
        whipper_file_path.rename(new_path)
    whipper_disc_path.rmdir()


if __name__ == "__main__":
    main()
