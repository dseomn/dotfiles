"""Script to load directories in Picard from a Quodlibet custom command."""

import os
import subprocess
import sys


def _fix_path(path: str) -> str:
    return "/".join(
        (
            os.environ["HOME"],
            "Music",
            "master.rw",
            *path.split("/")[-2:],
        )
    )


def main():
    subprocess.run(
        (
            "picard",
            "--",
            *map(_fix_path, sys.argv[1:]),
        ),
        check=True,
    )


if __name__ == "__main__":
    main()
