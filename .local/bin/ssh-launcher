"""Script to launch multiple ssh commands in their own tmux windows.

WARNING: This is probably not very robust against all possible valid known_hosts
files, since it uses a simple and custom parser.
"""

import argparse
from collections.abc import Iterable
import fnmatch
import pathlib
import subprocess
import time


def _known_hosts_files() -> Iterable[pathlib.Path]:
    config = subprocess.run(
        ("ssh", "-G", "does-not-exist"), check=True, stdout=subprocess.PIPE
    ).stdout.decode()
    for line in config.splitlines():
        option, *values = line.split(" ")
        if option not in ("globalknownhostsfile", "userknownhostsfile"):
            continue
        yield from map(pathlib.Path, values)


def _known_hosts(path: pathlib.Path) -> Iterable[str]:
    try:
        raw = path.read_text()
    except FileNotFoundError:
        return
    for line in raw.splitlines():
        if line.startswith("#") or not line:
            continue
        hosts, _, _ = line.partition(" ")
        yield hosts.partition(",")[0]


def _matching_hosts(host_glob: str) -> Iterable[str]:
    for known_hosts_path in _known_hosts_files():
        for host in _known_hosts(known_hosts_path):
            if fnmatch.fnmatchcase(host, host_glob):
                yield host


def _wait_for_shell_prompt(pane: str) -> None:
    while (
        not subprocess.run(
            ("tmux", "capture-pane", "-Jp", f"-t{pane}"),
            stdout=subprocess.PIPE,
            check=True,
        )
        .stdout.decode()
        .rstrip("\n")
        .endswith("$ ")
    ):
        time.sleep(0.02)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("-n", "--dry-run", action="store_true")
    parser.add_argument("-g", "--glob", action="store_true")
    parser.add_argument("host")
    args = parser.parse_args()

    for host in _matching_hosts(args.host) if args.glob else (args.host,):
        print(host)
        if args.dry_run:
            continue
        new_window = (
            subprocess.run(
                (
                    "tmux",
                    "new-window",
                    "-dPS",
                    f"-c{pathlib.Path.home()}",
                    "-F#{session_id}:#{window_id}",
                    f"-nssh {host}",
                ),
                stdout=subprocess.PIPE,
                check=True,
            )
            .stdout.decode()
            .rstrip()
        )
        if new_window:
            _wait_for_shell_prompt(new_window)
            subprocess.run(
                (
                    "tmux",
                    "send-keys",
                    "-l",
                    f"-t{new_window}",
                    f"ssh -Mt {host} tmux new-session -A",
                ),
                check=True,
            )


if __name__ == "__main__":
    main()
