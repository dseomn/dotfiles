[org/gnome/desktop]
/reset=true

[org/gnome/desktop/a11y]
always-show-universal-access-status=true

[org/gnome/desktop/background]
picture-uri='file://{{ env['HOME'] }}/.local/share/dotfiles/images/default-background.png'

[org/gnome/desktop/input-sources]
show-all-sources=true
# To test ibus-m17n: ('ibus', 'm17n:t:unimnim')
sources=[('ibus', 'typing-booster'), ('xkb', 'us')]
mru-sources=[('ibus', 'typing-booster'), ('xkb', 'us')]
xkb-options=['caps:escape_shifted_capslock']

[org/gnome/desktop/interface]
clock-format='24h'
clock-show-weekday=true
cursor-size/reset=false
font-name='System-ui 10'
document-font-name='Sans 10'
monospace-font-name='Monospace 10'
enable-hot-corners=false
show-battery-percentage=true
text-scaling-factor/reset=false

[org/gnome/desktop/notifications]
show-in-lock-screen=false

[org/gnome/desktop/notifications/application/org-gnome-software]
enable=false

[org/gnome/desktop/peripherals/keyboard]
numlock-state/reset=false

[org/gnome/desktop/peripherals/touchpad]
natural-scroll=false
tap-to-click=false

[org/gnome/desktop/peripherals/trackball]
scroll-wheel-emulation-button=8

[org/gnome/desktop/screensaver]
picture-uri='file://{{ env['HOME'] }}/.local/share/dotfiles/images/default-background.png'

[org/gnome/desktop/sound]
event-sounds=false

[org/gnome/desktop/wm/keybindings]
switch-applications=@as []
switch-applications-backward=@as []
switch-windows=['<Super>Tab', '<Alt>Tab']
switch-windows-backward=['<Shift><Super>Tab', '<Shift><Alt>Tab']

[org/gnome/desktop/wm/preferences]
num-workspaces=12
