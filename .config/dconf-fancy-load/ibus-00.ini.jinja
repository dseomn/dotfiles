[org/freedesktop/ibus]
/reset=true

[org/freedesktop/ibus/engine/typing-booster]
addspaceoncommit=false
autosettings=
  [
    # https://github.com/mike-fabian/ibus-typing-booster/issues/580
    ['prefercommit', 'false', '^SDL2_Application:']
  ]
candidatesdelaymilliseconds=@u 0
dictionary='en_US'
emojipredictions=false
emojitriggercharacters=''
inputmethod='t-rfc1345-plus'
keybindings=
  {
    'commit': <['Return']>,
    'commit_and_forward_key': <['Left']>,
    {%- for i in range(1, 10) %}
    'commit_candidate_{{ i }}': <['F{{ i }}']>,
    'commit_candidate_{{ i }}_plus_space': <@as []>,
    {%- endfor %}
    'lookup_related': <['F12']>,
    'next_case_mode': <@as []>,
    'previous_case_mode': <@as []>,
    'toggle_off_the_record': <@as []>,
    'trigger_emoji_predictions': <['Shift+Control+E']>,
    'trigger_word_predictions': <['Shift+Control+D']>
  }
offtherecord=true
pagesize=9
# 3 means nothing
recordmode=3
shownumberofcandidates=true
unicodedataall=true
wordpredictions=false
