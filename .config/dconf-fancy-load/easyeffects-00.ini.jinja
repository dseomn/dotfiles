[com/github/wwmm/easyeffects]
/reset=true
last-used-output-preset='default'
window-fullscreen/reset=false
window-height/reset=false
window-maximized/reset=false
window-width/reset=false

[com/github/wwmm/easyeffects/streaminputs]
input-device/reset=false

[com/github/wwmm/easyeffects/streamoutputs]
blocklist=['Lollypop', 'Quod Libet']
output-device/reset=false
plugins=['equalizer#0']
show-blocklisted-apps=true

[com/github/wwmm/easyeffects/streamoutputs/equalizer/0]
input-gain=-12.0
